flowchart TD
    A([Início: P1 e P2 no centro]) --> B{Ciclo menor ou igual a 25?}
    B -- não --> Z1([Derrota: ciclos esgotados])
    B -- sim --> C[Turno do P1: 2 ações]
    C --> D{Entrou no X?}
    D -- sim --> Z2([Vitória])
    D -- não --> E[Turno do P2: 2 ações]
    E --> F{Entrou no X?}
    F -- sim --> Z2
    F -- não --> G[Turno dos inimigos: cada inimigo ataca cada jogador do seu setor]
    G --> H{P1 e P2 eliminados?}
    H -- sim --> Z3([Derrota: jogadores eliminados])
    H -- não --> B

    subgraph Ação do jogador
        T1[Graficos desenha a tela] --> T2[Lê a opção]
        T2 --> T3{Ação permitida?}
        T3 -- não --> T4[Mostra o motivo e não conta a ação] --> T1
        T3 -- sim --> T5[Executa: atacar, procurar, movimentar ou recuperar]
        T5 --> T6[Remove inimigos com DEF menor ou igual a 0]
    end
